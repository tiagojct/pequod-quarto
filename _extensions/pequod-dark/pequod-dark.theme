{
    "_comment": "Pequod — dark Pandoc highlight theme. Crew dark variants mapped to syntax roles.",
    "text-color": "#EAE1D7",
    "background-color": "#0C222F",
    "line-number-color": "#BFBBB6",
    "line-number-background-color": null,
    "text-styles": {
        "Alert":          { "text-color": "#E3877C", "background-color": null, "bold": true,  "italic": false, "underline": false },
        "Annotation":     { "text-color": "#BFBBB6", "background-color": null, "bold": false, "italic": true,  "underline": false },
        "Attribute":      { "text-color": "#A6DFFF", "background-color": null, "bold": false, "italic": false, "underline": false },
        "BaseN":          { "text-color": "#DEC577", "background-color": null, "bold": false, "italic": false, "underline": false },
        "BuiltIn":        { "text-color": "#838CCF", "background-color": null, "bold": false, "italic": false, "underline": false },
        "Char":           { "text-color": "#82C4A2", "background-color": null, "bold": false, "italic": false, "underline": false },
        "Comment":        { "text-color": "#BFBBB6", "background-color": null, "bold": false, "italic": true,  "underline": false },
        "CommentVar":     { "text-color": "#BFBBB6", "background-color": null, "bold": false, "italic": true,  "underline": false },
        "Constant":       { "text-color": "#FFD9BB", "background-color": null, "bold": false, "italic": false, "underline": false },
        "ControlFlow":    { "text-color": "#E3877C", "background-color": null, "bold": true,  "italic": false, "underline": false },
        "DataType":       { "text-color": "#838CCF", "background-color": null, "bold": false, "italic": false, "underline": false },
        "DecVal":         { "text-color": "#DEC577", "background-color": null, "bold": false, "italic": false, "underline": false },
        "Documentation":  { "text-color": "#BFBBB6", "background-color": null, "bold": false, "italic": true,  "underline": false },
        "Error":          { "text-color": "#E3877C", "background-color": null, "bold": true,  "italic": false, "underline": true  },
        "Extension":      { "text-color": "#FFD9BB", "background-color": null, "bold": false, "italic": false, "underline": false },
        "Float":          { "text-color": "#DEC577", "background-color": null, "bold": false, "italic": false, "underline": false },
        "Function":       { "text-color": "#A6DFFF", "background-color": null, "bold": false, "italic": false, "underline": false },
        "Import":         { "text-color": "#FFD9BB", "background-color": null, "bold": false, "italic": false, "underline": false },
        "Information":    { "text-color": "#A6DFFF", "background-color": null, "bold": false, "italic": true,  "underline": false },
        "Keyword":        { "text-color": "#E3877C", "background-color": null, "bold": true,  "italic": false, "underline": false },
        "Normal":         { "text-color": "#EAE1D7", "background-color": null, "bold": false, "italic": false, "underline": false },
        "Operator":       { "text-color": "#BFBBB6", "background-color": null, "bold": false, "italic": false, "underline": false },
        "Other":          { "text-color": "#A17069", "background-color": null, "bold": false, "italic": false, "underline": false },
        "Preprocessor":   { "text-color": "#FFD9BB", "background-color": null, "bold": false, "italic": false, "underline": false },
        "RegionMarker":   { "text-color": "#A6DFFF", "background-color": null, "bold": false, "italic": true,  "underline": false },
        "SpecialChar":    { "text-color": "#BFBBB6", "background-color": null, "bold": false, "italic": false, "underline": false },
        "SpecialString":  { "text-color": "#82C4A2", "background-color": null, "bold": false, "italic": false, "underline": false },
        "String":         { "text-color": "#82C4A2", "background-color": null, "bold": false, "italic": false, "underline": false },
        "Variable":       { "text-color": "#A17069", "background-color": null, "bold": false, "italic": false, "underline": false },
        "VerbatimString": { "text-color": "#82C4A2", "background-color": null, "bold": false, "italic": false, "underline": false },
        "Warning":        { "text-color": "#FFD9BB", "background-color": null, "bold": true,  "italic": false, "underline": false }
    }
}
